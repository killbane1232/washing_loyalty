HTTP_ADDR=:8080
DATABASE_URL=postgres://loyalty:loyalty@localhost:5432/loyalty?sslmode=disable
POSTGRES_PASSWORD=loyalty
# Generate four DIFFERENT values: openssl rand -hex 32
AUTH_SECRET=
ADMIN_TOKEN=
CONNECTOR_TOKEN=
WEBHOOK_TOKEN=
TOKEN_TTL=24h
# Address for a host Go process. Compose uses its bundled connector service.
CONNECTOR_URL=http://localhost:8081
# Optional Compose override: CONNECTOR_CONTAINER_URL=http://external-connector:8081
CONNECTOR_TIMEOUT=5s

# Set true behind a production HTTPS reverse proxy.
COOKIE_SECURE=false
